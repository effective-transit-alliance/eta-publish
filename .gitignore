# Build output: regenerated from the source Google Doc on every run.
/out/

__pycache__/
*.py[cod]
.venv/
*.egg-info/

# OAuth client secret and token; never commit these.
client_secret*.json
token.json

# Scratch output directories from ad-hoc runs.
/out*/

# A clone of the private `eta-drafts`, a repository of its own:
# see `docs/drafts.md`.
/drafts/

# Where the `drafts-build` hook builds the drafts, removed once it's done.
/.drafts-check-*/

# Where `wrangler` caches which Cloudflare account and Pages project it deployed to,
# written in the checkout it runs from by `eta-publish drafts preview`.
/.wrangler/

# `site/` is the site, written by `eta-publish`, and
# `tests/fixture/` is the same shape built from a hand-written document.
# Only the text is committed: the images are 18 MB and the PDF 19 MB, and
# every re-fetch would add another copy to history forever. Both are
# rebuilt by CI before deploying, so nothing here is needed to publish.
/site/**/images/
/site/**/print/
/site/**/videos/
/site/**/report.pdf
/site/**/report.published.pdf
/site/**/statement.pdf
/site/**/statement.published.pdf
/site/**/template.typ
/site/unpublished/index.html
/site/unpublished/robots.txt
/tests/fixture/**/images/
/tests/fixture/**/print/
/tests/fixture/**/videos/
/tests/fixture/**/report.pdf
/tests/fixture/**/template.typ
/tests/fixture/**/report.published.pdf
/tests/fixture/index.html
/tests/fixture/robots.txt

# The `.min` copies and their source maps, which every build makes from the committed files.
/site/**/*.min.*
/tests/fixture/**/*.min.*

# Each publication as etany.org shows it, which every build makes
# from the committed fragment and the committed `eta_publish/assets/squarespace.html`.
/site/**/*.squarespace.html

# The npm packages `bun install` installs from `bun.lock`.
/node_modules/

# The `woff2` of each font, which every build makes from the `ttf` it downloads into the cache.
/site/**/assets/fonts/
