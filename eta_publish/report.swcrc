// What `swc` does to `report.js`, for `minify.py`.
//
// Compressed and with its names shortened, which is all a minifier is for,
// and with a source map carrying the script as written,
// so a browser's tools show that rather than one line of shortened names,
// without the original having to be served beside it.
{
  "minify": true,
  "jsc": {
    "target": "es2022",
    "minify": { "compress": true, "mangle": true }
  },
  "sourceMaps": true,
  "inlineSourcesContent": true
}
