  link("https://kkysen.github.io/eta-publish/reports/ibx-automation/images/Harsimus_Cove_HBLR_4th_St_RR_Crossing-d646232e.jpg")[#capped_image("print/Harsimus_Cove_HBLR_4th_St_RR_Crossing-d646232e.jpg", alt: "The at-grade station crossing at Harsimus Cove on HBLR, where passengers must cross in front of the train to access the other platform.")],
