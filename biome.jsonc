{
  "files": {
    // Not the charts: they are downloaded as somebody else made them and published as they are,
    // so laying them out would change their bytes for nothing,
    // and a lint rule one of them breaks would stop a build over a file nobody here can edit.
    // `biome` 2.3 never read an SVG; 2.5 formats and lints them.
    "includes": ["**", "!**/*.svg"]
  },
  "linter": {
    "rules": {
      "a11y": {
        // Every empty link here is a `#` mark with an `aria-label`,
        // which is its accessible name; this rule's HTML half does not read `aria-label`.
        "useAnchorContent": "off",
        // An alt text that says "photo" is the document's to fix, not the build's:
        // the build warns the author about it instead (`checks.py`),
        // and drops an opening "A photo" from a caption standing in as alt text.
        "noRedundantAlt": "off",
        // A video with no captions track is the document's too,
        // and failing on it would hold a report back over its writing.
        "useMediaCaption": "off"
      }
    }
  }
}
